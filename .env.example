# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Web3Forms (Password Reset Emails)
VITE_WEB3FORMS_KEY=your-web3forms-key

# Server-side chat provider secrets are set in Supabase, not Vite:
# LINGSHI_BASE_URL=https://api.lingshi.chat
# LINGSHI_API_KEY=sk-your-lingshi-key
# CHAT_MODELS=gpt-5.4-mini,gpt-5.4-low,gpt-5.4

# NVIDIA NIM API (For BGE-M3 embeddings - 1024 dimensions)
VITE_NVIDIA_API_KEY=nvapi-your-nvidia-api-key

# Google AI API (Alternative to OpenAI)
VITE_GOOGLE_API_KEY=your-google-api-key

# SerpAPI (server-side only; used by Cloudflare Pages Function /api/discover)
SERPAPI_API_KEY=your-serpapi-key
